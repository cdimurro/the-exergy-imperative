  "constants": {
    "celsius_zero_kelvin": 273.15,
    "solar_radiation_temperature_k": 5778.0,
    "standard_reference_temperature_c": 20.0,
    "standard_reference_pressure_pa": 101325.0
  },
  "rules": {
    "temperature_scale": "kelvin_absolute",
    "thermal_heat_relation": "source_temperature_must_be_greater_than_or_equal_to_reference_temperature",
    "cooling_relation": "ambient_temperature_must_be_greater_than_or_equal_to_cold_service_temperature",
    "sensible_heat_relation": "supply_temperature_must_be_greater_than_return_temperature_and_reference_must_not_produce_negative_exergy",
    "factor_domain": "finite_nonnegative",
    "weighted_factor_basis": "energy_or_power_weighted",
    "notation": "<quantity> <typed_unit>, fx = <factor> [declared context]"
  },
  "sources": [
    {
      "title": "Exergy of undiluted thermal radiation",
