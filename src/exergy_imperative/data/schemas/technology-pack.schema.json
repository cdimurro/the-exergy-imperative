{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cdimurro/the-exergy-imperative/schemas/technology-pack-v1.json",
  "title": "Exergy Imperative technology and process pack",
  "type": "object",
  "required": ["schema_version", "id", "version", "license", "description", "domains", "sources", "profiles"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["title", "license", "applicable_boundary"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "applicable_boundary": {"type": "string", "minLength": 1},
          "url": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"enum": ["reference", "carrier", "service", "technology", "intensity"]},
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "source_id", "parameters"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "label": {"type": "string"},
            "aliases": {"type": "array", "items": {"type": "string"}},
            "source_id": {"type": "string", "minLength": 1},
            "boundary": {"type": "string"},
            "model": {"type": "string", "minLength": 1},
            "performance_parameter": {"type": "string", "minLength": 1},
            "required_inputs": {"type": "array", "items": {"type": "string"}},
            "recommended_overrides": {"type": "array", "items": {"type": "string"}},
            "parameters": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/parameter"}
            }
          },
          "additionalProperties": true
        }
      }
    },
    "technology_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "performance_parameter", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "performance_parameter": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "maximum_performance": {"type": "number", "exclusiveMinimum": 0},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "relation": {"const": "input-times-performance"}
        },
        "additionalProperties": false
      }
    },
    "material_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "source_id", "boundary", "required_inputs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "source_id": {"type": "string", "minLength": 1},
          "boundary": {"type": "string", "minLength": 1},
          "required_inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "process_templates": {"type": "array", "items": {"type": "object"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["value", "unit", "confidence"],
      "properties": {
        "value": {},
        "unit": {"type": "string", "minLength": 1},
        "low": {"type": "number"},
        "high": {"type": "number"},
        "confidence": {"type": "string", "minLength": 1},
        "method_id": {"type": "string"},
        "note": {"type": "string"},
        "source_id": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "evidence_kind": {"type": "string"},
        "statistic": {"type": "string", "minLength": 1},
        "range_basis": {"type": "string", "minLength": 1},
        "applicability": {
          "type": "object",
          "required": ["technology", "boundary", "geography", "vintage"],
          "properties": {
            "technology": {"type": "string", "minLength": 1},
            "boundary": {"type": "string", "minLength": 1},
            "geography": {"type": "string", "minLength": 1},
            "vintage": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "when"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "when": {"type": "object", "minProperties": 1},
              "priority": {"type": "number"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"evidence_kind": {"const": "published_estimate"}},
            "required": ["evidence_kind"]
          },
          "then": {
            "required": ["low", "high", "source_id", "source_version", "statistic", "range_basis", "applicability"]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
