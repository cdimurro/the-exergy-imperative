{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cdimurro/the-exergy-imperative/schemas/agent-recipe-v1.json",
  "title": "Exergy Imperative agent recipe",
  "type": "object",
  "required": ["workflow", "inputs"],
  "properties": {
    "schema_version": {"const": "1.0", "default": "1.0"},
    "workflow": {"type": "string", "minLength": 1},
    "mode": {
      "type": "string",
      "enum": ["execute", "dry-run", "validate-only"],
      "default": "execute"
    },
    "inputs": {"type": "object"},
    "outputs": {
      "type": "object",
      "properties": {
        "json": {"type": "string", "minLength": 1},
        "html": {"type": "string", "minLength": 1},
        "pdf": {"type": "string", "minLength": 1},
        "xlsx": {"type": "string", "minLength": 1},
        "excel_directory": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
