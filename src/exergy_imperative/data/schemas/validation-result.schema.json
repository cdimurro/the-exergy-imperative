{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cdimurro/the-exergy-imperative/schemas/validation-result-v1.json",
  "title": "Exergy Imperative validation suite result",
  "type": "object",
  "required": ["schema_version", "suite_id", "passed", "passed_cases", "total_cases", "source", "outcomes", "notes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "passed_cases": {"type": "integer", "minimum": 0},
    "total_cases": {"type": "integer", "minimum": 0},
    "source": {"type": "string"},
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "title", "expected", "actual", "absolute_tolerance", "relative_tolerance", "passed", "citation", "validation_type", "capabilities", "message"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "expected": {"type": "number"},
          "actual": {"type": ["number", "null"]},
          "absolute_tolerance": {"type": "number", "minimum": 0},
          "relative_tolerance": {"type": "number", "minimum": 0},
          "passed": {"type": "boolean"},
          "citation": {"type": "object"},
          "validation_type": {"type": "string"},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
